# PostgreSQL utama (jangan diubah ke database shadow)
# PRODUCTION: gunakan koneksi dengan TLS (mis. ?sslmode=require) dan user
# database dengan privilege minimum.
DATABASE_URL="postgresql://cbt_user:cbt_password@localhost:5432/cbt_db?schema=public"

# Database terpisah untuk Prisma Migrate di development.
# Role cbt_user tidak punya CREATEDB, jadi shadow DB disediakan terpisah.
# PRODUCTION: tidak dipakai; jalankan `prisma migrate deploy`, bukan `migrate dev`.
SHADOW_DATABASE_URL="postgresql://cbt_user:cbt_password@localhost:5432/cbt_shadow?schema=public"

# Wajib. Generate dengan: openssl rand -hex 32
# Dipakai better-auth untuk menandatangani session dan cookie cache RBAC.
# PRODUCTION: gunakan secret acak >= 32 byte; rotasi akan logout semua sesi.
BETTER_AUTH_SECRET=""

# Base URL aplikasi. Menentukan atribut Secure pada cookie (https => Secure).
# PRODUCTION: wajib https://domain-aplikasi.
BETTER_AUTH_URL="http://localhost:3000"

# URL publik aplikasi, didaftarkan sebagai trusted origin better-auth.
# PRODUCTION: samakan dengan BETTER_AUTH_URL (https).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Jangan commit file .env. Jangan menjalankan seed/reset di production.

